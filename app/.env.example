# Account Focus configuration. Copy to .env and fill in what you use:  cp .env.example .env
# Nothing here is needed for offline mode (npm run offline).

# --- Server ---
# offline | live. Leave unset to use live when SNOWFLAKE_ACCOUNT is set, offline otherwise.
FOCUS_MODE=
FOCUS_HOST=127.0.0.1
FOCUS_PORT=3200
# Shown as a link in Slack messages, for example http://127.0.0.1:3200
FOCUS_PUBLIC_URL=

# --- Snowflake (live mode). See docs/SETUP_SNOWFLAKE.md ---
# Account identifier, for example myorg-myaccount (no .snowflakecomputing.com)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=ACCOUNT_FOCUS_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=.keys/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=ACCOUNT_FOCUS_APP
SNOWFLAKE_WAREHOUSE=ACCOUNT_FOCUS_WH
SNOWFLAKE_DATABASE=ACCOUNT_FOCUS
SNOWFLAKE_SCHEMA=CORE

# --- Slack (optional). See docs/SETUP_SLACK.md ---
# Bot token starts with xoxb-, app-level token starts with xapp-
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated Slack user IDs allowed to accept, snooze or reject picks. Empty = anyone in the workspace.
FOCUS_SELLER_SLACK_IDS=
# Channel ID (C…) or user ID (U…) for npm run send-brief
FOCUS_BRIEF_CHANNEL=
